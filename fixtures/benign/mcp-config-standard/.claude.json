{
  "numStartups": 42,
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem@1.2.3", "/Users/example/projects"]
    },
    "sqlite": {
      "command": "uvx",
      "args": ["mcp-server-sqlite==0.4.1", "--db-path", "/Users/example/data/app.db"]
    },
    "time": {
      "command": "docker",
      "args": ["run", "-i", "--rm", "ghcr.io/example/mcp-time:1.4.0"],
      "env": {"TZ": "UTC", "LOG_LEVEL": "info"}
    }
  },
  "projects": {
    "/Users/example/projects/site": {
      "mcpServers": {
        "postgres": {
          "command": "npx",
          "args": ["-y", "@modelcontextprotocol/server-postgres@0.6.2", "postgresql://localhost:5432/site"]
        }
      }
    }
  }
}
